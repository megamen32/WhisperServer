# Copy to .env and change values before exposing the server to a network.
API_KEY=dev-local-key
MODEL=gigaam-v3
OPENAI_DEFAULT_MODEL=gigaam-v3
OPENAI_WHISPER_MIN_MODEL=medium
WEBUI_SESSION_TTL_SECONDS=2592000
# Web UI audio spool: retained until the user deletes the job.
# Keep these limits within the host's reviewed disk and memory budget.
WEBUI_JOB_DIR=whisper_cache/webui_jobs
WEBUI_MAX_FILE_BYTES=268435456
WEBUI_MAX_SPOOL_BYTES=2147483648
# Community-1: accept model conditions on Hugging Face; keep token server-side.
HF_TOKEN=

# Telegram bot
TG_BOT_ENABLED=false
TG_BOT_TOKEN=
TG_BOT_SERVER_URL=http://127.0.0.1:7653/transcribe
TG_BOT_API_KEY=
TG_BOT_MODEL=gigaam-v3
TG_BOT_LANG=ru
TG_BOT_MAX_SIZE_MB=40
TG_BOT_CONCURRENCY=4
TG_BOT_HTTP_PROXY=

# CUDA broker
CUDABROKER_CLIENT_ID=whisper
CUDABROKER_WHISPER_TTL_SECONDS=900

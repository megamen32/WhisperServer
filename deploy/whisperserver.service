[Unit]
Description=WhisperServer FastAPI with Telegram bot subprocess
After=network.target

[Service]
Type=simple
User=roomhacker
Group=roomhacker
WorkingDirectory=/home/roomhacker/PycharmProjects/WhisperServer
EnvironmentFile=/home/roomhacker/PycharmProjects/WhisperServer/.env
ExecStart=/home/roomhacker/PycharmProjects/WhisperServer/.venv/bin/python /home/roomhacker/PycharmProjects/WhisperServer/scripts/runtime.py run
Restart=always
RestartSec=5
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
